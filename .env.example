# Only needed for --live runs. Nothing offline reads these.
# Your Foundry resource's OpenAI v1 endpoint, e.g. https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
# Key auth. Leave empty to sign in with Entra ID (DefaultAzureCredential).
AZURE_OPENAI_API_KEY=
# Optional Entra ID scope override.
# AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Optional tokens-per-minute overrides for the rate limiter, e.g. gpt-6-luna=100000
# TRIAGE_TPM=
